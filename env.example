# === ОБЯЗАТЕЛЬНО ===
BOT_TOKEN=сюда_токен_от_BotFather
ANTHROPIC_API_KEY=сюда_ключ_с_console.anthropic.com

# === МОЖНО НЕ ТРОГАТЬ ===
CLAUDE_MODEL=claude-sonnet-5-5
TIMEZONE=Europe/Moscow
# напоминать только с 10:00 до 21:00
WORK_START=10
WORK_END=21
# проверять переписку раз в 60 минут
CHECK_EVERY_MIN=60
# первое напоминание — через 3 часа после вопроса
FIRST_REMIND_AFTER_H=3
# повторять не чаще раза в 6 часов
REMIND_EVERY_H=6
# после 3 напоминаний без ответа — сообщить вам
MAX_REMINDERS=3
# не встревать, если в чате переписывались последние 30 минут
QUIET_AFTER_ACTIVITY_MIN=30
# анализировать переписку за последние 7 дней
LOOKBACK_DAYS=7
REMINDER_PREFIX=🤖 Напоминание
DB_PATH=reminder_bot.db
# модель расшифровки голосовых: small (2 ГБ памяти), medium (точнее, 4 ГБ), off — выключить
WHISPER_MODEL=small
# присылать вам вопросы, на которые ответили голосом/фото: 1 — да, 0 — нет
FORWARD_MEDIA_ANSWERS=1
